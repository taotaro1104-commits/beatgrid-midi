{
  "name": "beatgrid-midi",
  "version": "0.1.0",
  "description": "Turn detected beats into a MIDI tempo map, quantize transcribed notes to it, and write a Standard MIDI File. Zero dependencies, runs in the browser and Node.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "example": "npm run build && node examples/drifting-tempo.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "midi",
    "tempo-map",
    "quantize",
    "beat-tracking",
    "audio-to-midi",
    "music-transcription",
    "basic-pitch",
    "smf",
    "web-audio"
  ],
  "homepage": "https://midi.newlife-startup.com/en/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/beatgrid-midi.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/beatgrid-midi/issues"
  },
  "license": "MIT",
  "author": "newlife-startup (https://newlife-startup.com/)",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
